+      style={{
+        position: 'fixed',
+        bottom: '15px',
+        right: '15px',
+        backgroundColor: config.color,
+        color: 'white',
+        padding: '8px 12px',
+        borderRadius: '20px',
+        fontSize: '12px',
+        fontWeight: 'bold',
+        zIndex: 1000,
+        boxShadow: '0 3px 10px rgba(0,0,0,0.2)',
+        display: 'flex',
+        alignItems: 'center',
+        gap: '5px',
+        cursor: 'pointer',
+        transition: 'transform 0.2s ease',
+        userSelect: 'none',
+        textDecoration: 'none'  // Remove underline
+      }}
+      onMouseEnter={(e) => e.currentTarget.style.transform = 'scale(1.05)'}
