-      display: 'flex',
-      alignItems: 'center',
-      gap: '5px',
-      cursor: 'pointer',
-      transition: 'transform 0.2s ease',
-      userSelect: 'none'
-    }}
-    onMouseEnter={(e) => e.currentTarget.style.transform = 'scale(1.05)'}
-    onMouseLeave={(e) => e.currentTarget.style.transform = 'scale(1.0)'}
-    title={`Currently viewing ${config.name}`}
