+    'sprint-2': { emoji: '🌸', name: 'sprint-2', color: '#ff6b9d' },
+    'sprint-3': { emoji: '🌻', name: 'sprint-3', color: '#f39c12' },
+    'sprint-4': { emoji: '🌺', name: 'sprint-4', color: '#e91e63' },
