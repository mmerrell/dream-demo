-    'sprint-5': { emoji: '🌷', name: 'Sprint-5', color: '#9b59b6' },
-    'sprint-6': { emoji: '🌼', name: 'Sprint-6', color: '#f1c40f' },
-    'sprint-7': { emoji: '🌿', name: 'Sprint-7', color: '#27ae60' },
